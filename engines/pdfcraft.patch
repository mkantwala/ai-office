+    /// Open caller-provided bytes without filesystem access (desktop hosts and WebAssembly).
+    pub fn open_bytes(&mut self, name: &str, bytes: Vec<u8>, password: Option<&str>) -> Result<DocId> {
+        if bytes.len() > 128 * 1024 * 1024 { return Err(failed("Document exceeds the 128 MB limit")); }
+        self.session.open(name, None, Arc::new(bytes), password).map_err(failed)
+    }
+
+    /// Insert caller-provided image bytes using the same engine edit as page_add_image.
+    pub fn image_bytes(&mut self, id: DocId, page: usize, name: &str, bytes: Vec<u8>) -> Result<()> {
+        if bytes.len() > 16 * 1024 * 1024 { return Err(failed("Image exceeds the 16 MB limit")); }
+        self.session.apply(id, Edit::AddImage { page, rect: None, name: name.into(), bytes: Arc::new(bytes) }).map_err(failed)
+    }
