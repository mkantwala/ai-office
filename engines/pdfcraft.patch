+//! PDF editing and rendering for AI Office, using the CLI's automation commands.
+#![cfg(target_arch = "wasm32")]
+#![deny(clippy::unwrap_used, clippy::expect_used, clippy::panic, clippy::unimplemented, clippy::todo, clippy::unreachable)]
+
+use pdfcraft_automation::{Automation, Content};
+use pdfcraft_render::{PageRenderer, RenderConfig, RenderRequest, RequestKind};
+use serde_json::{Value, json};
+use std::sync::Arc;
+use wasm_bindgen::prelude::*;
+
+#[wasm_bindgen]
+pub struct OfficeDocument {
+    renderer: PageRenderer,
+    sizes: Vec<[f32; 2]>,
+    width: u32,
+    height: u32,
+    automation: Automation,
+    id: pdfcraft_engine::DocId,
+    password: Option<String>,
+    page: usize,
+}
+
+#[wasm_bindgen]
+impl OfficeDocument {
+    #[wasm_bindgen(constructor)]
+    pub fn new(name: &str, bytes: &[u8], password: Option<String>) -> Result<OfficeDocument, JsValue> {
+        if bytes.len() > 128 * 1024 * 1024 {
+            return Err(JsValue::from_str("PDF exceeds the 128 MB limit"));
+        }
+        let bytes = Arc::new(bytes.to_vec());
+        let info = pdfcraft_render::inspect(bytes.clone(), password.as_deref()).map_err(|e| JsValue::from_str(&e.to_string()))?;
+        if info.pages.len() > 10000 {
+            return Err(JsValue::from_str("PDF exceeds the 10,000-page limit"));
+        }
+        let sizes: Vec<_> = info.pages.iter().map(|p| [p.width, p.height]).collect();
+        if sizes.iter().flatten().any(|v| !v.is_finite() || *v <= 0.0 || *v > 14400.0) {
+            return Err(JsValue::from_str("PDF has an unsupported page size"));
+        }
+        let mut automation = Automation::new();
+        let id = automation.open_bytes(name, bytes.as_ref().clone(), password.as_deref()).map_err(js_error)?;
+        let renderer =
+            PageRenderer::new(bytes, RenderConfig { password: password.clone().map(Arc::from), reject_oversize: true, ..Default::default() });
+        Ok(Self { renderer, sizes, width: 0, height: 0, automation, id, password, page: 0 })
+    }
+
+    pub fn execute(&mut self, command: &str, params: &str) -> Result<String, JsValue> {
+        if params.len() > 2 * 1024 * 1024 {
+            return Err(JsValue::from_str("Command is too large"));
+        }
+        let mut args: Value = serde_json::from_str(params).map_err(js_error)?;
+        if !args.is_object() {
+            return Err(JsValue::from_str("Expected command arguments"));
+        }
+        if let Some(page) = args.get("page").and_then(Value::as_u64) {
+            let page = usize::try_from(page).map_err(js_error)?.checked_sub(1).ok_or_else(|| JsValue::from_str("Pages are 1-based"))?;
+            if page >= self.sizes.len() {
+                return Err(JsValue::from_str("Page does not exist"));
+            }
+            self.page = page;
+        }
+        if command != "select.page" {
+            if !allowed(command) {
+                return Err(JsValue::from_str("Command is not enabled in AI Office"));
+            }
+            args["doc"] = json!(self.id.0);
+            self.automation.call(command, &args).map_err(js_error)?;
+            self.refresh()?;
+        }
+        self.state()
+    }
+
+    pub fn image(&mut self, page: usize, name: &str, bytes: &[u8]) -> Result<String, JsValue> {
+        self.automation.image_bytes(self.id, page, name, bytes.to_vec()).map_err(js_error)?;
+        self.refresh()?;
+        self.state()
+    }
+
+    pub fn commands(&self) -> Result<String, JsValue> {
+        let commands: Vec<_> = pdfcraft_automation::tools()
+            .into_iter()
+            .filter(|t| allowed(t.name))
+            .map(|t| json!({"id":t.name,"label":t.title,"params":t.input_schema}))
+            .collect();
+        serde_json::to_string(&commands).map_err(js_error)
+    }
+
+    pub fn state(&mut self) -> Result<String, JsValue> {
+        let content = self.automation.call("text_paragraphs", &json!({"doc":self.id.0,"page":self.page + 1})).map_err(js_error)?;
+        let paragraphs =
+            content.into_iter().find_map(|c| if let Content::Json(v) = c { v.get("paragraphs").cloned() } else { None }).unwrap_or(json!([]));
+        let doc = self.automation.session().get(self.id).ok_or_else(|| JsValue::from_str("Document closed"))?;
+        let comments: Vec<_> = doc
+            .info
+            .annotations
+            .iter()
+            .filter(|a| a.page == self.page && a.contents.is_some())
+            .map(|a| json!({"author":a.author,"text":a.contents}))
+            .collect();
+        serde_json::to_string(&json!({"page":self.page,"blocks":paragraphs,"comments":comments,"revision":doc.edit_generation(),"undo":doc.can_undo().is_some(),"redo":doc.can_redo().is_some()})).map_err(js_error)
+    }
+
+    pub fn export(&self) -> Result<Vec<u8>, JsValue> {
+        self.automation.session().save_bytes(self.id).map(|b| b.as_ref().clone()).map_err(js_error)
+    }
+
+    fn refresh(&mut self) -> Result<(), JsValue> {
+        let doc = self.automation.session().get(self.id).ok_or_else(|| JsValue::from_str("Document closed"))?;
+        self.renderer = PageRenderer::new(
+            doc.bytes.clone(),
+            RenderConfig { password: self.password.clone().map(Arc::from), reject_oversize: true, ..Default::default() },
+        );
+        Ok(())
+    }
+
+    pub fn pages(&self) -> Result<String, JsValue> {
+        serde_json::to_string(&self.sizes).map_err(|e| JsValue::from_str(&e.to_string()))
+    }
+
+    pub fn render(&mut self, index: usize, scale: f32) -> Result<Vec<u8>, JsValue> {
+        let [w, h] = *self.sizes.get(index).ok_or_else(|| JsValue::from_str("Page does not exist"))?;
+        if !scale.is_finite() || scale <= 0.0 {
+            return Err(JsValue::from_str("Invalid page scale"));
+        }
+        let scale = scale.min(4096.0 / w).min(4096.0 / h).min((8_000_000.0 / (w * h)).sqrt());
+        let result = self.renderer.render(RenderRequest { page: index, kind: RequestKind::Pixels, tile: None, scale, tag: 0, preview: false });
+        if let Some(error) = result.error {
+            return Err(JsValue::from_str(&error));
+        }
+        self.width = result.width;
+        self.height = result.height;
+        let mut bytes = result.rgba.to_vec();
+        for pixel in bytes.as_chunks_mut::<4>().0 {
+            let alpha = pixel[3] as u32;
+            if alpha > 0 && alpha < 255 {
+                for channel in pixel.iter_mut().take(3) {
+                    *channel = ((*channel as u32 * 255 + alpha / 2) / alpha).min(255) as u8;
+                }
+            }
+        }
+        Ok(bytes)
+    }
+
+    #[wasm_bindgen(getter)]
+    pub fn width(&self) -> u32 {
+        self.width
+    }
+    #[wasm_bindgen(getter)]
+    pub fn height(&self) -> u32 {
+        self.height
+    }
+}
+
+fn js_error(error: impl std::fmt::Display) -> JsValue {
+    JsValue::from_str(&error.to_string())
+}
+fn allowed(command: &str) -> bool {
+    matches!(command, "text_edit" | "page_add_text" | "content_update" | "comment_add" | "link_add" | "edit_undo" | "edit_redo")
+}
