+++ b/apps/ai-office-preview/src/bin/sangam-pdf.rs
@@ -0,0 +1,199 @@
+//! Persistent, confined PDF engine for Sangam One. No network or MCP listener.
+use pdfcraft_automation::{Automation, Content};
+use pdfcraft_engine::DocId;
+use pdfcraft_render::{PageRenderer, RenderRequest, RequestKind};
+use serde_json::{Value, json};
+use std::io::{self, BufRead, Write};
+use std::path::PathBuf;
+
+struct Host {
+    automation: Automation,
+    root: PathBuf,
+    id: Option<DocId>,
+    page: usize,
+    result: Value,
+    renderer: Option<PageRenderer>,
+}
+
+fn supported(name: &str) -> bool {
+    !name.starts_with("ocr_")
+        && !matches!(
+            name,
+            "doc_open" | "doc_list" | "doc_close" | "doc_save" | "command_run" | "command_batch" | "command_list" | "doc_inspect" | "render_preview"
+        )
+}
+impl Host {
+    fn id(&self) -> Result<DocId, String> {
+        self.id.ok_or_else(|| "Open a PDF first".into())
+    }
+    fn state(&mut self) -> Result<Value, String> {
+        let id = self.id()?;
+        let doc = self.automation.session().get(id).ok_or("Document closed")?;
+        self.page = self.page.min(doc.info.pages.len().saturating_sub(1));
+        let blocks = self.automation.call("text_paragraphs", &json!({"doc":id.0,"page":self.page+1}));
+        let (paragraphs, text_error) = match blocks {
+            Ok(parts) => (
+                parts
+                    .into_iter()
+                    .find_map(|part| if let Content::Json(value) = part { value.get("paragraphs").cloned() } else { None })
+                    .unwrap_or(json!([])),
+                None,
+            ),
+            Err(error) => (json!([]), Some(error.to_string())),
+        };
+        let doc = self.automation.session().get(id).ok_or("Document closed")?;
+        let sizes: Vec<_> = doc.info.pages.iter().map(|p| [p.width, p.height]).collect();
+        let comments: Vec<_> = doc
+            .info
+            .annotations
+            .iter()
+            .filter(|a| a.page == self.page && a.contents.is_some())
+            .map(|a| json!({"author":a.author,"text":a.contents}))
+            .collect();
+        Ok(
+            json!({"pages":sizes,"state":{"revision":doc.edit_generation(),"undo":doc.can_undo().is_some(),"redo":doc.can_redo().is_some(),"page":self.page,"blocks":paragraphs,"comments":comments,"textError":text_error,"agentCommandResult":self.result}}),
+        )
+    }
+    fn call(&mut self, message: &Value) -> Result<Value, String> {
+        let method = message.get("method").and_then(Value::as_str).ok_or("Missing method")?;
+        let args = message.get("args").cloned().unwrap_or(json!({}));
+        match method {
+            "open" => {
+                let path = args.get("path").and_then(Value::as_str).ok_or("Missing path")?;
+                let mut open=json!({"path":path}); if let Some(password)=args.get("password").and_then(Value::as_str){open["password"]=json!(password);}
+                let result = self.automation.call("doc_open", &open).map_err(|e|e.to_string())?;
+                let id = result.into_iter().find_map(|part| if let Content::Json(value) = part { value.get("doc").and_then(Value::as_u64) } else { None }).ok_or("Missing document receipt")?;
+                self.id = Some(DocId(id));
+                self.state()
+            }
+            "commands" => Ok(Value::Array(pdfcraft_automation::tools().into_iter().filter(|tool|supported(tool.name)).map(|tool| {
+                let mut schema = tool.input_schema;
+                if tool.name=="doc_batch" && let Some(options)=schema.pointer_mut("/properties/steps/items/enum").and_then(Value::as_array_mut){options.retain(|value|value!="ocr");}
+                if let Some(properties) = schema.get_mut("properties").and_then(Value::as_object_mut) { properties.remove("doc"); }
+                if let Some(required) = schema.get_mut("required").and_then(Value::as_array_mut) { required.retain(|item|item!="doc"); }
+                json!({"id":tool.name,"label":tool.title,"description":tool.description,"readOnly":tool.read_only,"destructive":tool.destructive,"params":schema})
+            }).collect())),
+            "close_source" => {
+                let id=DocId(args.get("doc").and_then(Value::as_u64).ok_or("Missing source document")?);
+                if Some(id)==self.id {return Err("Cannot close the active PDF".into());}
+                self.automation.call("doc_close",&json!({"doc":id.0,"discard_changes":true})).map_err(|e|e.to_string())?;
+                Ok(json!(true))
+            }
+            "open_source" => {
+                let result = self.automation.call("doc_open", &args).map_err(|e|e.to_string())?;
+                Ok(Value::Array(result.into_iter().filter_map(|part|if let Content::Json(value)=part {Some(value)}else{None}).collect()))
+            }
+            "execute" => {
+                let command = args.get("command").and_then(Value::as_str).ok_or("Missing command")?;
+                let mut params = args.get("params").cloned().unwrap_or(json!({}));
+                if !params.is_object() { return Err("Expected an argument object".into()); }
+                if command == "select.page" {
+                    let page = params.get("page").and_then(Value::as_u64).ok_or("Pages are 1-based integers")?;
+                    let count = self.automation.session().get(self.id()?).ok_or("Document closed")?.info.pages.len();
+                    if page == 0 || page as usize > count { return Err("Page does not exist".into()); }
+                    self.page = page as usize-1; self.result = Value::Null;
+                    return self.state();
+                }
+                if !supported(command) { return Err("Operation is managed by the application or excluded (OCR)".into()); }
+                let definition = pdfcraft_automation::tools().into_iter().find(|tool|tool.name==command).ok_or("Unknown command")?;
+                if definition.input_schema.get("properties").and_then(|p|p.get("doc")).is_some() { params["doc"] = json!(self.id()?.0); }
+                // Signing writes a separate artifact. Keep the editor's original bytes and history.
+                let signing_source=if command=="sign_document" {
+                    let doc=self.automation.session().get(self.id()?).ok_or("Document closed")?;
+                    let name=doc.name.clone();let password=doc.export_source().config.password.clone();
+                    let bytes=self.automation.session().save_bytes(self.id()?).map_err(|e|e.to_string())?;
+                    let id=self.automation.open_bytes(&name,bytes.as_ref().clone(),password.as_deref()).map_err(|e|e.to_string())?;
+                    params["doc"]=json!(id.0);Some(id)
+                }else{None};
+                let before: Vec<_> = self.automation.session().docs().iter().map(|doc|doc.id).collect();
+                if command=="doc_batch" && params.get("steps").and_then(Value::as_array).is_some_and(|steps|steps.iter().any(|step|step.as_str()==Some("ocr"))) {return Err("OCR is excluded".into());}
+                if command=="action_run" {
+                    let custom=params.get("steps").and_then(Value::as_array).is_some_and(|steps|steps.iter().any(|step|step.get("step").and_then(Value::as_str)==Some("recognize_text")));
+                    let builtin=params.get("action").and_then(Value::as_str).is_some_and(|name|pdfcraft_engine::actions::builtin().iter().any(|action|action.name.eq_ignore_ascii_case(name)&&action.steps.iter().any(|step|matches!(step,pdfcraft_engine::actions::Step::RecognizeText))));
+                    if custom||builtin{return Err("OCR is excluded".into());}
+                }
+                let output = self.automation.call(command, &params);
+                if let Some(id)=signing_source {self.automation.call("doc_close",&json!({"doc":id.0,"discard_changes":true})).map_err(|e|e.to_string())?;}
+                let output=output.map_err(|e|e.to_string())?;
+                let mut values = Vec::new();
+                for (index,part) in output.into_iter().enumerate() {
+                    match part {
+                        Content::Json(mut value)=>{
+                            if command=="action_list" {
+                                if let Some(steps)=value.get_mut("steps").and_then(Value::as_array_mut){steps.retain(|step|step.get("step").and_then(Value::as_str)!=Some("recognize_text"));}
+                                if let Some(actions)=value.get_mut("actions").and_then(Value::as_array_mut){actions.retain(|action|!action.get("steps").and_then(Value::as_array).is_some_and(|steps|steps.iter().any(|step|step.get("step").and_then(Value::as_str)==Some("recognize_text"))));}
+                            }
+                            values.push(value)
+                        },
+                        Content::Png{data,width,height}=>{let name=format!("output/preview-{index}.png"); self.automation.write_output(&name,&data).map_err(|e|e.to_string())?;values.push(json!({"path":name,"width":width,"height":height,"mime":"image/png"}));}
+                    }
+                }
+                let created:Vec<_>=self.automation.session().docs().iter().filter(|doc|!before.contains(&doc.id)).map(|doc|(doc.id,doc.name.clone(),doc.info.pages.len())).collect();
+                for (id,title,pages) in created {
+                    let name=format!("output/document-{}.pdf",id.0);
+                    let bytes=self.automation.session().save_bytes(id).map_err(|e|e.to_string())?;
+                    self.automation.write_output(&name,bytes.as_slice()).map_err(|e|e.to_string())?;
+                    values.push(json!({"created_document":name,"name":title,"pages":pages}));
+                    self.automation.call("doc_close",&json!({"doc":id.0,"discard_changes":true})).map_err(|e|e.to_string())?;
+                }
+                self.result = Value::Array(values); self.renderer=None;
+                self.state()
+            }
+            "saved" => {
+                self.automation.call("doc_save",&json!({"doc":self.id()?.0})).map_err(|e|e.to_string())?;
+                self.renderer=None;self.state()
+            }
+            "export" => {
+                let bytes=self.automation.session().save_bytes(self.id()?).map_err(|e|e.to_string())?;
+                let path=self.root.join("snapshot.pdf"); std::fs::write(&path,bytes.as_slice()).map_err(|e|e.to_string())?;
+                Ok(json!({"path":path}))
+            }
+            "render" => {
+                let page=args.get("page").and_then(Value::as_u64).ok_or("Missing page")? as usize;
+                let scale=args.get("scale").and_then(Value::as_f64).ok_or("Missing scale")? as f32;
+                if !scale.is_finite() || scale<=0.0 {return Err("Invalid scale".into());}
+                let doc=self.automation.session().get(self.id()?).ok_or("Document closed")?;
+                let info=doc.info.pages.get(page).ok_or("Page does not exist")?;
+                let (w,h)=(info.width,info.height); let scale=scale.min(4096.0/w).min(4096.0/h).min((8_000_000.0/(w*h)).sqrt());
+                if self.renderer.is_none(){let source=doc.export_source();self.renderer=Some(PageRenderer::new(source.bytes,source.config));}
+                let result=self.renderer.as_mut().ok_or("Renderer unavailable")?.render(RenderRequest{page,kind:RequestKind::Pixels,tile:None,scale,tag:0,preview:false});
+                if let Some(error)=result.error{return Err(error);}
+                let mut pixels=result.rgba.to_vec();
+                for pixel in pixels.as_chunks_mut::<4>().0{let alpha=u32::from(pixel[3]);if alpha>0&&alpha<255{for channel in pixel.iter_mut().take(3){*channel=((u32::from(*channel)*255+alpha/2)/alpha).min(255)as u8;}}}
+                let path=self.root.join("raster.raw");std::fs::write(&path,&pixels).map_err(|e|e.to_string())?;
+                Ok(json!({"path":path,"width":result.width,"height":result.height}))
+            }
+            _=>Err("Unknown engine request".into()),
+        }
+    }
+}
+fn main() -> Result<(), Box<dyn std::error::Error>> {
+    let root = std::env::args().nth(1).ok_or("Missing private working directory")?;
+    let root = std::fs::canonicalize(root)?;
+    let automation = Automation::new().with_root(&root)?;
+    let mut host = Host { automation, root, id: None, page: 0, result: Value::Null, renderer: None };
+    let input = io::stdin();
+    let mut output = io::stdout().lock();
+    for line in input.lock().lines() {
+        let line = line?;
+        if line.len() > 32 * 1024 * 1024 {
+            return Err("Request exceeds the engine budget".into());
+        }
+        let message: Value = match serde_json::from_str(&line) {
+            Ok(value) => value,
+            Err(_) => {
+                writeln!(output, "{}", json!({"id":null,"error":"Invalid request JSON"}))?;
+                output.flush()?;
+                continue;
+            }
+        };
+        let id = message.get("id").cloned().unwrap_or(Value::Null);
+        let response = match host.call(&message) {
+            Ok(result) => json!({"id":id,"result":result}),
+            Err(error) => json!({"id":id,"error":error}),
+        };
+        writeln!(output, "{response}")?;
+        output.flush()?;
+    }
+    Ok(())
+}
