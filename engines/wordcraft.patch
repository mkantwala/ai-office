+//! Content-only Word pagination and rendering for AI Office.
+#![cfg(target_arch = "wasm32")]
+#![deny(clippy::unwrap_used, clippy::expect_used, clippy::panic, clippy::unimplemented, clippy::todo, clippy::unreachable)]
+
+use serde_json::{Value, json};
+use std::sync::Arc;
+use wasm_bindgen::prelude::*;
+use wordcraft_engine::Session;
+use wordcraft_layout::DocLayout;
+mod agent;
+mod review;
+
+#[wasm_bindgen]
+pub struct OfficeDocument {
+    session: Session,
+    layout: Arc<DocLayout>,
+    width: u32,
+    height: u32,
+    password: Option<String>,
+    id_prefix: String,
+    id_counter: u64,
+    review: review::Review,
+}
+
+#[wasm_bindgen]
+impl OfficeDocument {
+    #[wasm_bindgen(constructor)]
+    pub fn new(name: &str, bytes: &[u8], password: Option<String>) -> Result<OfficeDocument, JsValue> {
+        if bytes.len() > 128 * 1024 * 1024 {
+            return Err(JsValue::from_str("Document exceeds the 128 MB limit"));
+        }
+        let (doc, _) = wordcraft_engine::io::open_bytes_with(name, bytes, password.as_deref()).map_err(|e| JsValue::from_str(&e))?;
+        let mut session = Session::new(doc);
+        let layout = session.layout();
+        if layout.pages.len() > 10000 || layout.pages.iter().any(|p| [p.w, p.h].iter().any(|v| !v.is_finite() || *v <= 0.0 || *v > 14400.0)) {
+            return Err(JsValue::from_str("Document exceeds the page count or page size limit"));
+        }
+        Ok(Self { session, layout, width: 0, height: 0, password, id_prefix: String::new(), id_counter: 0, review: review::Review::default() })
+    }
+
+    pub fn pages(&self) -> Result<String, JsValue> {
+        let sizes: Vec<_> = self.layout.pages.iter().map(|page| [page.w, page.h]).collect();
+        serde_json::to_string(&sizes).map_err(|e| JsValue::from_str(&e.to_string()))
+    }
+
+    /// The same command ids and parameters used by wordcraft-cli and MCP.
+    pub fn execute(&mut self, command: &str, params: &str) -> Result<String, JsValue> {
+        if params.len() > 24 * 1024 * 1024 {
+            return Err(JsValue::from_str("Command is too large"));
+        }
+        if !allowed(command) {
+            return Err(JsValue::from_str("Command is not enabled in AI Office"));
+        }
+        let args: Value = serde_json::from_str(params).map_err(|e| JsValue::from_str(&e.to_string()))?;
+        self.session.close_typing();
+        self.session.run(command, &args).map_err(|e| JsValue::from_str(&e.to_string()))?;
+        if !self.id_prefix.is_empty() {
+            agent::normalize(&mut self.session.doc, &self.id_prefix, &mut self.id_counter);
+        }
+        self.layout = self.session.layout();
+        self.state()
+    }
+
+    pub fn commands(&self) -> Result<String, JsValue> {
+        let list: Vec<_> =
+            self.session.registry.all().iter().filter(|c| allowed(c.id)).map(|c| json!({"id": c.id, "label": c.label, "params": c.params})).collect();
+        serde_json::to_string(&list).map_err(|e| JsValue::from_str(&e.to_string()))
+    }
+
+    pub fn state(&self) -> Result<String, JsValue> {
+        let sel = &self.session.sel;
+        let caret = self
+            .layout
+            .caret_on(&sel.focus, self.session.page_hint)
+            .map(|c| json!({"page":c.page,"x":c.x,"y":c.top,"height":c.height,"width":c.width}));
+        let rects: Vec<_> = self
+            .layout
+            .selection_rects(&self.session.doc, &sel.anchor, &sel.focus, self.session.page_hint)
+            .iter()
+            .map(|(page, r)| json!({"page":page,"x":r.x,"y":r.y,"width":r.w,"height":r.h}))
+            .collect();
+        let comments: Vec<_> = self
+            .session
+            .doc
+            .comments
+            .iter()
+            .map(|(id,c)| json!({"commentId":id,"parentId":c.parent,"resolved":c.resolved,"author":c.author,"text":self.session.doc.plain_text(wordcraft_doc::StoryRef::Part(c.part))}))
+            .collect();
+        let paths =
+            if sel.is_collapsed() { vec![sel.focus.path.clone()] } else { self.session.doc.para_paths_in(&sel.ordered().0, &sel.ordered().1) };
+        let at = paths.first().unwrap_or(&sel.focus.path);
+        let paragraph = self.session.doc.para(sel.focus.story, at).map(|p| {
+            let properties = wordcraft_engine::cmd::paragraph_properties::read(&self.session.doc, &p.props);
+            let mut mixed = std::collections::BTreeSet::new();
+            for path in paths.iter().skip(1) {
+                if let Some(other) = self.session.doc.para(sel.focus.story, path) {
+                    let other = wordcraft_engine::cmd::paragraph_properties::read(&self.session.doc, &other.props);
+                    for (key, value) in properties.as_object().into_iter().flatten() {
+                        if other.get(key) != Some(value) {
+                            mixed.insert(key.clone());
+                        }
+                    }
+                }
+            }
+            let r = self.session.doc.styles.resolve_para(&p.props);
+            let ruler = self
+                .layout
+                .caret_on(&sel.focus, self.session.page_hint)
+                .and_then(|c| self.layout.pages.get(c.page))
+                .filter(|page| {
+                    sel.focus.story == wordcraft_doc::StoryRef::Body
+                        && at.0.len() == 1
+                        && !r.bidi
+                        && !r.mirror_indents
+                        && r.frame.is_none()
+                        && r.numbering.is_none()
+                        && self.session.doc.sections().get(page.section).is_some_and(|(_, s)| s.columns.count == 1)
+                })
+                .map(|page| json!({"left":page.body.x,"width":page.body.w}));
+            json!({"id":p.props.office_id,"properties":properties,"mixed":mixed,"ruler":ruler})
+        });
+        let style = self.session.doc.para(sel.focus.story, &sel.focus.path).and_then(|p| p.props.style.as_deref()).unwrap_or("Normal");
+        serde_json::to_string(&json!({"paragraph":paragraph,"undoDepth":self.session.undo_depth(),"paragraphStyle":style,"selection":sel,"caret":caret,"rects":rects,"comments":comments,"selectedText":self.session.selected_text(),"revision":self.session.rev(),"undo":self.session.can_undo(),"redo":self.session.can_redo()})).map_err(|e| JsValue::from_str(&e.to_string()))
+    }
+
+    pub fn export(&self) -> Result<Vec<u8>, JsValue> {
+        wordcraft_engine::io::save_bytes_with("document.docx", &self.session.doc, self.password.as_deref(), &Default::default())
+            .map_err(|e| JsValue::from_str(&e))
+    }
+
+    pub fn agent_init(&mut self, prefix: &str, metadata: &str) -> Result<(), JsValue> {
+        if prefix.is_empty() || prefix.len() > 60 {
+            return Err(JsValue::from_str("Invalid identity prefix"));
+        }
+        self.id_prefix = prefix.into();
+        if let Ok(value) = serde_json::from_str(metadata) {
+            let _ = agent::restore_ids(&mut self.session.doc, &value);
+        }
+        agent::normalize(&mut self.session.doc, prefix, &mut self.id_counter);
+        Ok(())
+    }
+
+    pub fn agent_metadata(&self) -> String {
+        agent::metadata(&self.session.doc).to_string()
+    }
+
+    pub fn review_start(&mut self) -> Result<(), JsValue> {
+        self.review.start(&self.session.doc).map_err(|e| JsValue::from_str(&e))
+    }
+
+    pub fn review_finish(&mut self) {
+        self.review.finish(&self.session.doc);
+    }
+
+    pub fn review_read(&mut self) -> String {
+        self.review.refresh(&self.session.doc);
+        self.review.read().to_string()
+    }
+
+    pub fn review_export(&self) -> String {
+        self.review.export()
+    }
+    pub fn review_import(&mut self, value: &str) -> Result<(), JsValue> {
+        self.review.import(value).map_err(|e| JsValue::from_str(&e))
+    }
+    pub fn review_projection(&self) -> String {
+        review::Review::projection(&self.session.doc)
+    }
+
+    pub fn review_decide(&mut self, revision: u64, action: &str, keys: &str) -> Result<String, JsValue> {
+        if revision != self.session.rev() {
+            return Err(JsValue::from_str("Document changed. Refresh the review before deciding."));
+        }
+        let keys: Vec<String> = serde_json::from_str(keys).map_err(|e| JsValue::from_str(&e.to_string()))?;
+        let result = self.review.decide(&self.session.doc, action, &keys).map_err(|e| JsValue::from_str(&e))?;
+        if self.session.doc != result {
+            self.session.close_typing();
+            self.session.checkpoint("Undo agent change");
+            self.session.doc = result;
+            self.session.clamp_selection();
+            self.session.touch();
+            self.session.relayout();
+            self.layout = self.session.layout();
+        }
+        self.state()
+    }
+
+    pub fn agent_read(&self, args: &str) -> Result<String, JsValue> {
+        let args: Value = serde_json::from_str(args).map_err(|e| JsValue::from_str(&e.to_string()))?;
+        if args["operation"] == "comments" {
+            return Ok(agent::comments(&self.session.doc, &args).to_string());
+        }
+        if let Some(id) = args["sectionId"].as_str() {
+            let node = agent::target(&self.session.doc, id).map_err(|e| JsValue::from_str(&e))?;
+            if node.kind != "heading" {
+                return Err(JsValue::from_str("sectionId must identify a heading"));
+            }
+        }
+        if args["operation"] == "styles" {
+            let query = args["query"].as_str().unwrap_or("").to_lowercase();
+            let builtin = wordcraft_doc::styles::StyleSheet::builtin();
+            let mut styles = self.session.doc.styles.styles.clone();
+            styles.extend(builtin.styles.iter().filter(|s| self.session.doc.styles.get(&s.id).is_none()).cloned());
+            let values: Vec<_> = styles
+                .iter()
+                .filter(|s| query.is_empty() || s.name.to_lowercase().contains(&query) || s.id.to_lowercase().contains(&query))
+                .take(50)
+                .map(|s| {
+                    let sheet = if self.session.doc.styles.get(&s.id).is_some() { &self.session.doc.styles } else { &builtin };
+                    let format = sheet.resolve_char(Some(&s.id), &Default::default());
+                    json!({"id":s.id,"name":s.name,"size":format.size,"font":format.font})
+                })
+                .collect();
+            return Ok(json!({"styles":values}).to_string());
+        }
+        if args["operation"] == "selection" {
+            let selection = &self.session.sel;
+            let all = agent::nodes(&self.session.doc);
+            let focus = all.iter().find(|n| n.story == selection.focus.story && n.path == selection.focus.path);
+            let anchor = all.iter().find(|n| n.story == selection.anchor.story && n.path == selection.anchor.path);
+            let offset =
+                |pos: &wordcraft_doc::Pos| self.session.doc.para_at(pos).map_or(0, |p| p.text.get(..pos.off).unwrap_or(&p.text).chars().count());
+            let result = focus.map(|n| agent::read(&self.session.doc, &json!({"id":n.id}))).unwrap_or(json!({"blocks":[]}));
+            return Ok(json!({"content":result,"selection":{"anchorId":anchor.map(|n|&n.id),"focusId":focus.map(|n|&n.id),"start":offset(&selection.anchor),"end":offset(&selection.focus)},"selectedText":self.session.selected_text().chars().take(8000).collect::<String>()}).to_string());
+        }
+        Ok(agent::read(&self.session.doc, &args).to_string())
+    }
+
+    pub fn agent_rects(&self, id: &str) -> Result<String, JsValue> {
+        agent::rects(&self.session.doc, &self.layout, id).map(|v| v.to_string()).map_err(|e| JsValue::from_str(&e))
+    }
+
+    pub fn agent_edit(&mut self, args: &str) -> Result<String, JsValue> {
+        if args.len() > 160_000 {
+            return Err(JsValue::from_str("Agent edit is too large"));
+        }
+        let args: Value = serde_json::from_str(args).map_err(|e| JsValue::from_str(&e.to_string()))?;
+        let before_ids: std::collections::HashSet<_> = agent::nodes(&self.session.doc).into_iter().map(|n| n.id).collect();
+        // Prepare on a private copy: failures leave content, revision, selection and undo intact.
+        let mut draft = Session::new(self.session.doc.clone());
+        draft.sel = self.session.sel.clone();
+        draft.author = self.session.author.clone();
+        let edits = if args["operation"] == "batch" {
+            let edits = args["edits"].as_array().ok_or_else(|| JsValue::from_str("edits must be an array"))?;
+            if edits.is_empty() || edits.len() > 200 {
+                return Err(JsValue::from_str("A batch requires 1-200 edits"));
+            }
+            if edits.iter().any(|edit| edit["operation"] == "batch") {
+                return Err(JsValue::from_str("Nested batches are not supported"));
+            }
+            edits.clone()
+        } else {
+            vec![args.clone()]
+        };
+        agent::validate_guards(&self.session.doc, &edits, args["revision"].as_u64() == Some(self.session.rev()))
+            .map_err(|error| JsValue::from_str(&error))?;
+        let mut applied = Vec::new();
+        let mut command_result = Value::Null;
+        for edit in &edits {
+            command_result = agent::edit(&mut draft, edit).map_err(|e| JsValue::from_str(&e))?;
+            applied.push(json!({"id":edit["id"],"operation":edit["operation"],"action":edit["action"],"commentId":edit["commentId"],"command":edit["command"],"params":edit["params"]}));
+        }
+        agent::normalize(&mut draft.doc, &self.id_prefix, &mut self.id_counter);
+        if self.session.doc != draft.doc {
+            self.session.close_typing();
+            self.session.checkpoint("Agent document edit");
+            self.session.doc = draft.doc;
+            self.session.sel = draft.sel;
+            self.session.touch();
+        }
+        self.session.relayout();
+        self.layout = self.session.layout();
+        let nodes = agent::nodes(&self.session.doc);
+        let created: std::collections::HashSet<_> = nodes.iter().filter(|n| !before_ids.contains(&n.id)).map(|n| n.id.clone()).collect();
+        let roots: Vec<_> = nodes
+            .iter()
+            .filter(|n| created.contains(&n.id) && !created.contains(&n.parent))
+            .take(50)
+            .map(|n| json!({"id":n.id,"kind":n.kind,"parentId":n.parent}))
+            .collect();
+        let mut result: Value = serde_json::from_str(&self.state()?).map_err(|e| JsValue::from_str(&e.to_string()))?;
+        result["agentCreatedBlocks"] = json!(roots);
+        result["agentCommandResult"] = command_result;
+        result["agentAppliedEdits"] = json!(applied);
+        Ok(result.to_string())
+    }
+
+    pub fn render(&mut self, index: usize, scale: f32) -> Result<Vec<u8>, JsValue> {
+        let page = self.layout.pages.get(index).ok_or_else(|| JsValue::from_str("Page does not exist"))?;
+        if !scale.is_finite() || scale <= 0.0 {
+            return Err(JsValue::from_str("Invalid page scale"));
+        }
+        let scale = scale.min(4096.0 / page.w).min(4096.0 / page.h).min((8_000_000.0 / (page.w * page.h)).sqrt());
+        let result = wordcraft_render::render_page(&self.session.doc, page, scale, &Default::default());
+        self.width = result.width;
+        self.height = result.height;
+        Ok(result.to_straight())
+    }
+
+    #[wasm_bindgen(getter)]
+    pub fn width(&self) -> u32 {
+        self.width
+    }
+    #[wasm_bindgen(getter)]
+    pub fn height(&self) -> u32 {
+        self.height
+    }
+}
+
+fn allowed(command: &str) -> bool {
+    matches!(
+        command,
+        "text.insert"
+            | "text.newParagraph"
+            | "text.lineBreak"
+            | "text.tab"
+            | "text.backTab"
+            | "text.backspace"
+            | "text.delete"
+            | "caret.set"
+            | "caret.left"
+            | "caret.right"
+            | "caret.up"
+            | "caret.down"
+            | "caret.home"
+            | "caret.end"
+            | "caret.docStart"
+            | "caret.docEnd"
+            | "select.all"
+            | "select.range"
+            | "select.word"
+            | "select.text"
+            | "select.collapse"
+            | "format.bold"
+            | "format.strikethrough"
+            | "format.color"
+            | "format.highlight"
+            | "format.clear"
+            | "format.italic"
+            | "format.underline"
+            | "format.font"
+            | "format.size"
+            | "para.properties"
+            | "para.align"
+            | "para.style"
+            | "para.bullets"
+            | "para.numbering"
+            | "para.lineSpacing"
+            | "insert.table"
+            | "insert.picture"
+            | "insert.link"
+            | "review.newComment"
+            | "review.comments"
+            | "edit.undo"
+            | "edit.redo"
+    )
+}
diff --git a/apps/ai-office-preview/src/review.rs b/apps/ai-office-preview/src/review.rs
new file mode 100644
index 0000000..d6a8998
--- /dev/null
+++ b/apps/ai-office-preview/src/review.rs
@@ -0,0 +1,348 @@
+//! Document review over private native snapshots; exported only to local version storage.
+use serde_json::{Value, json};
+use std::collections::BTreeMap;
+use std::sync::Arc;
+use wordcraft_doc::{Block, Blocks, Document};
+
+#[derive(Default)]
+pub struct Review {
+    baseline: Option<Document>,
+    proposed: Option<Document>,
+}
+
+fn id(block: &Block) -> &str {
+    match block {
+        Block::Para(p) => &p.props.office_id,
+        Block::Table(t) => &t.props.office_id,
+    }
+}
+
+fn roots(doc: &Document) -> BTreeMap<String, Arc<Block>> {
+    let mut result = BTreeMap::new();
+    for block in &doc.body {
+        result.insert(format!("body:{}", id(block)), block.clone());
+    }
+    for (part, value) in &doc.parts {
+        for block in &value.blocks {
+            result.insert(format!("part{part}:{}", id(block)), block.clone());
+        }
+    }
+    result
+}
+
+fn scrub(value: &mut Value) {
+    match value {
+        Value::Object(map) => {
+            map.remove("officeId");
+            for item in map.values_mut() {
+                scrub(item);
+            }
+        }
+        Value::Array(items) => {
+            for item in items {
+                scrub(item);
+            }
+        }
+        _ => {}
+    }
+}
+
+fn metadata(doc: &Document) -> Value {
+    let mut value = json!(doc);
+    if let Some(map) = value.as_object_mut() {
+        map.remove("body");
+        map.remove("core");
+        if let Some(parts) = map.get_mut("parts").and_then(Value::as_object_mut) {
+            for part in parts.values_mut() {
+                if let Some(part) = part.as_object_mut() {
+                    part.remove("blocks");
+                }
+            }
+        }
+    }
+    scrub(&mut value);
+    value
+}
+
+fn properties(value: Value) -> String {
+    let mut value = value;
+    scrub(&mut value);
+    value
+        .as_object()
+        .map(|map| {
+            map.iter()
+                .filter(|(_, value)| !value.is_null())
+                .map(|(key, value)| {
+                    let name =
+                        key.chars().flat_map(|c| if c.is_uppercase() { vec![' ', c.to_ascii_lowercase()] } else { vec![c] }).collect::<String>();
+                    format!("{name}: {}", value.as_str().map(str::to_string).unwrap_or_else(|| value.to_string()))
+                })
+                .collect::<Vec<_>>()
+                .join("; ")
+        })
+        .unwrap_or_default()
+}
+
+fn display(block: &Block) -> String {
+    match block {
+        Block::Para(p) => {
+            let mut text = format!("{}\nParagraph formatting: {}\n", p.text, properties(json!(p.props)));
+            let mut offset = 0;
+            for run in &p.runs {
+                let end = (offset + run.len).min(p.text.len());
+                let format = properties(json!(run.props));
+                if !format.is_empty() {
+                    let content = p.text.get(offset..end).unwrap_or("");
+                    text.push_str(&format!("Character formatting for {content:?}: {format}\n"));
+                }
+                offset = end;
+            }
+            if !p.objects.is_empty() {
+                let mut objects = json!(p.objects);
+                scrub(&mut objects);
+                text.push_str(&format!("Inline objects, links and annotations: {objects}\n"));
+            }
+            text
+        }
+        Block::Table(table) => {
+            let mut text = format!("Table formatting: {}\nColumn widths: {:?}\n", properties(json!(table.props)), table.grid);
+            for (row_index, row) in table.rows.iter().enumerate() {
+                text.push_str(&format!("Row {} formatting: {}\n", row_index + 1, properties(json!(row.props))));
+                for (cell_index, cell) in row.cells.iter().enumerate() {
+                    text.push_str(&format!("Row {}, column {}\n", row_index + 1, cell_index + 1));
+                    text.push_str(&format!("Cell formatting: {}\n", properties(json!(cell.props))));
+                    for block in &cell.blocks {
+                        text.push_str(&display(block));
+                    }
+                }
+            }
+            text
+        }
+    }
+}
+
+fn plain_text(block: &Block) -> String {
+    match block {
+        Block::Para(p) => p.text.clone(),
+        Block::Table(t) => t
+            .rows
+            .iter()
+            .map(|r| r.cells.iter().map(|c| c.blocks.iter().map(|b| plain_text(b)).collect::<Vec<_>>().join("\n")).collect::<Vec<_>>().join(" | "))
+            .collect::<Vec<_>>()
+            .join("\n"),
+    }
+}
+
+fn ordered_roots(doc: &Document) -> Vec<String> {
+    doc.body
+        .iter()
+        .map(|b| format!("body:{}", id(b)))
+        .chain(doc.parts.iter().flat_map(|(part, value)| value.blocks.iter().map(move |b| format!("part{part}:{}", id(b)))))
+        .collect()
+}
+
+fn anchor(base: &Document, after: &Document, key: &str) -> Value {
+    let current = roots(after);
+    if let Some(block) = current.get(key) {
+        return json!({"id":id(block),"after":false});
+    }
+    let ordered = ordered_roots(base);
+    if let Some(index) = ordered.iter().position(|k| k == key) {
+        let story = key.split(':').next();
+        for next in &ordered[index + 1..] {
+            if next.split(':').next() == story {
+                if let Some(block) = current.get(next) {
+                    return json!({"id":id(block),"after":false});
+                }
+            }
+        }
+        for previous in ordered[..index].iter().rev() {
+            if previous.split(':').next() == story {
+                if let Some(block) = current.get(previous) {
+                    return json!({"id":id(block),"after":true});
+                }
+            }
+        }
+    }
+    json!(null)
+}
+
+fn document_text(doc: &Document) -> String {
+    let blocks = roots(doc);
+    let mut text = ordered_roots(doc).iter().filter_map(|key| blocks.get(key).map(|block| display(block))).collect::<Vec<_>>().join("\n");
+    text.push_str(&format!("\nDocument formatting and annotations:\n{}\n", metadata(doc)));
+    text
+}
+
+fn copy_root(target: &mut Document, source: &Document, key: &str) -> Result<(), String> {
+    let (story, block_id) = key.split_once(':').ok_or("Invalid review change")?;
+    let (target_blocks, source_blocks): (&mut Blocks, &Blocks) = if story == "body" {
+        (&mut target.body, &source.body)
+    } else {
+        let part: u32 = story.strip_prefix("part").ok_or("Invalid story")?.parse().map_err(|_| "Invalid story")?;
+        (
+            &mut target.parts.get_mut(&part).ok_or("Document structure changed")?.blocks,
+            &source.parts.get(&part).ok_or("Document structure changed")?.blocks,
+        )
+    };
+    let old_position = target_blocks.iter().position(|block| id(block) == block_id);
+    let replacement = source_blocks.iter().position(|block| id(block) == block_id);
+    match (old_position, replacement) {
+        (Some(position), Some(index)) => target_blocks[position] = source_blocks[index].clone(),
+        (Some(position), None) => {
+            target_blocks.remove(position);
+        }
+        (None, Some(index)) => {
+            let next = source_blocks[index + 1..].iter().find_map(|block| target_blocks.iter().position(|candidate| id(candidate) == id(block)));
+            let position = next.unwrap_or(target_blocks.len());
+            target_blocks.insert(position, source_blocks[index].clone());
+        }
+        (None, None) => {}
+    }
+    Ok(())
+}
+
+impl Review {
+    pub fn refresh(&mut self, doc: &Document) {
+        let (Some(base), Some(after)) = (&self.baseline, &self.proposed) else {
+            return;
+        };
+        if metadata(doc) == metadata(base) && roots(doc) == roots(base) {
+            self.baseline = None;
+            self.proposed = None;
+            return;
+        }
+        if metadata(base) != metadata(after) {
+            return;
+        }
+        let old = roots(base);
+        let proposed = roots(after);
+        let current = roots(doc);
+        let mut next = after.clone();
+        for key in old.keys().chain(proposed.keys()).collect::<std::collections::BTreeSet<_>>() {
+            if old.get(key) != proposed.get(key) && current.get(key) == old.get(key) {
+                let _ = copy_root(&mut next, base, key);
+            }
+        }
+        self.proposed = Some(next);
+    }
+    pub fn start(&mut self, doc: &Document) -> Result<(), String> {
+        self.refresh(doc);
+        if let (Some(base), Some(proposed)) = (&mut self.baseline, &self.proposed) {
+            let before = roots(base);
+            let after = roots(proposed);
+            let current = roots(doc);
+            if metadata(proposed) != metadata(doc) {
+                return Err("Document changed since the pending review. Keep or resolve its changes first.".into());
+            }
+            for key in before.keys().chain(after.keys()).chain(current.keys()).collect::<std::collections::BTreeSet<_>>() {
+                if before.get(key) != after.get(key) && current.get(key) != after.get(key) {
+                    return Err("A pending agent change was edited manually. Keep it before asking the agent to edit again.".into());
+                }
+                if before.get(key) == after.get(key) && current.get(key) != after.get(key) {
+                    copy_root(base, doc, key)?;
+                }
+            }
+        } else {
+            self.baseline = Some(doc.clone());
+        }
+        self.proposed = Some(doc.clone());
+        Ok(())
+    }
+
+    pub fn finish(&mut self, doc: &Document) {
+        self.proposed = Some(doc.clone());
+    }
+
+    pub fn read(&self) -> Value {
+        let (Some(base), Some(after)) = (&self.baseline, &self.proposed) else {
+            return json!({"changes":[]});
+        };
+        if metadata(base) != metadata(after) {
+            return json!({"changes":[{"id":"document","label":"Document structure, formatting and annotations","before":document_text(base),"after":document_text(after),"beforeText":"","afterText":"","anchor":ordered_roots(after).first().map(|key|anchor(base,after,key))}]});
+        }
+        let original = roots(base);
+        let proposed = roots(after);
+        let mut keys = ordered_roots(base);
+        for key in ordered_roots(after) {
+            if !keys.contains(&key) {
+                keys.push(key);
+            }
+        }
+        let changes: Vec<_> = keys.iter().filter(|key| original.get(*key) != proposed.get(*key)).map(|key| json!({
+            "id":key,"label":if proposed.get(key).or_else(||original.get(key)).is_some_and(|block|matches!(block.as_ref(),Block::Table(_))) {"Table change"} else {"Paragraph change"},
+            "before":original.get(key).map(|block|display(block)).unwrap_or_default(),"after":proposed.get(key).map(|block|display(block)).unwrap_or_default(),
+            "beforeText":original.get(key).map(|block|plain_text(block)).unwrap_or_default(),"afterText":proposed.get(key).map(|block|plain_text(block)).unwrap_or_default(),"anchor":anchor(base,after,key)
+        })).collect();
+        json!({"changes":changes})
+    }
+
+    pub fn export(&self) -> String {
+        json!({"schema":1,"baseline":self.baseline,"proposed":self.proposed}).to_string()
+    }
+    pub fn import(&mut self, value: &str) -> Result<(), String> {
+        let data: Value = serde_json::from_str(value).map_err(|e| e.to_string())?;
+        if data["schema"] != 1 {
+            return Err("Unsupported document review version".into());
+        }
+        let baseline: Option<Document> = serde_json::from_value(data["baseline"].clone()).map_err(|e| e.to_string())?;
+        let proposed: Option<Document> = serde_json::from_value(data["proposed"].clone()).map_err(|e| e.to_string())?;
+        if baseline.is_some() != proposed.is_some() {
+            return Err("Incomplete document review version".into());
+        }
+        self.baseline = baseline;
+        self.proposed = proposed;
+        Ok(())
+    }
+    pub fn projection(doc: &Document) -> String {
+        document_text(doc)
+    }
+
+    pub fn decide(&mut self, doc: &Document, action: &str, keys: &[String]) -> Result<Document, String> {
+        if action != "keep" && action != "undo" {
+            return Err("Unknown review decision".into());
+        }
+        let (Some(base), Some(after)) = (&self.baseline, &self.proposed) else {
+            return Err("No pending changes".into());
+        };
+        let available = self.read();
+        let changes = available["changes"].as_array().ok_or("Review unavailable")?;
+        if keys.is_empty() || keys.iter().any(|key| !changes.iter().any(|change| change["id"].as_str() == Some(key))) {
+            return Err("Review changed. Refresh the differences before deciding.".into());
+        }
+        let mut next_base = base.clone();
+        let mut next_after = after.clone();
+        let mut result = doc.clone();
+        for key in keys {
+            if key == "document" {
+                if action == "undo" {
+                    if doc != after {
+                        return Err("Document changed since review. Undo would overwrite later edits. Keep it or resolve the conflict first.".into());
+                    }
+                    result = base.clone();
+                    result.core = doc.core.clone();
+                    next_after = result.clone();
+                } else {
+                    next_base = after.clone();
+                }
+            } else {
+                if action == "undo" {
+                    if roots(doc).get(key) != roots(after).get(key) {
+                        return Err("This paragraph or table changed since review. Undo would overwrite your edits.".into());
+                    }
+                    copy_root(&mut result, base, key)?;
+                    copy_root(&mut next_after, base, key)?;
+                } else {
+                    copy_root(&mut next_base, after, key)?;
+                }
+            }
+        }
+        self.baseline = Some(next_base);
+        self.proposed = Some(next_after);
+        if self.read()["changes"].as_array().is_some_and(Vec::is_empty) {
+            self.baseline = None;
+            self.proposed = None;
+        }
+        Ok(result)
+    }
+}
