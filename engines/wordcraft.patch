diff --git a/apps/wordcraft-web/src/office.rs b/apps/wordcraft-web/src/office.rs
new file mode 100644
index 0000000..6ce2066
--- /dev/null
+++ b/apps/wordcraft-web/src/office.rs
@@ -0,0 +1,243 @@
+//! The full WordCraft web interface hosted in an AI Office document tab.
+use serde_json::{Value, json};
+use std::cell::RefCell;
+use std::collections::VecDeque;
+use wasm_bindgen::prelude::*;
+use wordcraft_ui_egui::{Services, WordApp};
+
+struct Request {
+    id: u32,
+    method: String,
+    args: Value,
+    bytes: Vec<u8>,
+}
+thread_local! {
+    static QUEUE: RefCell<VecDeque<Request>> = const { RefCell::new(VecDeque::new()) };
+    static CONTEXT: RefCell<Option<egui::Context>> = const { RefCell::new(None) };
+}
+
+#[wasm_bindgen]
+extern "C" {
+    #[wasm_bindgen(catch, js_namespace = globalThis, js_name = aiOfficeWordEvent)]
+    fn host_event(kind: &str, id: u32, json: &str, bytes: &[u8]) -> Result<(), JsValue>;
+}
+
+fn emit(kind: &str, id: u32, data: Value, bytes: &[u8]) {
+    if let Err(error) = host_event(kind, id, &data.to_string(), bytes) {
+        log::error!("AI Office bridge: {error:?}");
+    }
+}
+
+#[wasm_bindgen]
+pub fn office_request(id: u32, method: &str, params: &str, bytes: &[u8]) -> Result<(), JsValue> {
+    if params.len() > 4 * 1024 * 1024 || bytes.len() > 128 * 1024 * 1024 {
+        return Err(JsValue::from_str("Request exceeds the size limit"));
+    }
+    if !matches!(method, "open" | "inbox" | "export" | "saved" | "control") {
+        return Err(JsValue::from_str("Unknown host request"));
+    }
+    let args = serde_json::from_str(params).map_err(|e| JsValue::from_str(&e.to_string()))?;
+    QUEUE.with(|queue| {
+        let mut queue = queue.try_borrow_mut().map_err(|_| JsValue::from_str("Bridge is busy"))?;
+        if queue.len() >= 64 {
+            return Err(JsValue::from_str("Too many pending requests"));
+        }
+        queue.push_back(Request { id, method: method.into(), args, bytes: bytes.to_vec() });
+        Ok(())
+    })?;
+    CONTEXT.with(|context| {
+        if let Ok(context) = context.try_borrow()
+            && let Some(ctx) = context.as_ref()
+        {
+            ctx.request_repaint();
+        }
+    });
+    Ok(())
+}
+
+pub fn ready(ctx: egui::Context) {
+    CONTEXT.with(|context| {
+        if let Ok(mut context) = context.try_borrow_mut() {
+            *context = Some(ctx);
+        }
+    });
+    emit("ready", 0, json!({}), &[]);
+}
+
+pub fn failed(error: &str) {
+    emit("fatal", 0, json!({"error":error}), &[]);
+}
+
+pub fn services(mut services: Services) -> Services {
+    services.open_async = Some(Box::new(|purpose| emit("pick", 0, json!({"purpose":purpose}), &[])));
+    services.host_command = Some(Box::new(|command, params| {
+        if matches!(command, "edit.paste" | "edit.pasteText" | "edit.pasteMerge") && params.as_object().is_none_or(|p| p.is_empty()) {
+            emit("paste", 0, json!({"command":command}), &[]);
+            return Some(Ok(json!({"pending":"host"})));
+        }
+        if matches!(
+            command,
+            "file.new" | "file.open" | "file.close" | "file.save" | "file.saveAs" | "file.exportPdf" | "file.exportPng" | "file.printPdf"
+        ) {
+            if command == "file.new" {
+                let mut session = wordcraft_engine::Session::new(wordcraft_doc::Document::from_text(""));
+                let result = session
+                    .run("file.new", params)
+                    .map_err(|e| e.to_string())
+                    .and_then(|_| wordcraft_engine::io::save_bytes_with("Untitled.docx", &session.doc, None, &Default::default()));
+                return Some(result.map(|bytes| {
+                    emit("new", 0, json!({}), &bytes);
+                    json!({"pending":"host"})
+                }));
+            }
+            emit("action", 0, json!({"command":command,"params":params}), &[]);
+            return Some(Ok(json!({"pending":"host"})));
+        }
+        None
+    }));
+    services
+}
+
+#[derive(Default)]
+pub struct Bridge {
+    loaded: bool,
+    revision: Option<u64>,
+    holding: bool,
+}
+impl Bridge {
+    pub fn holding(&self) -> bool {
+        self.holding
+    }
+    pub fn tick(&mut self, app: &mut WordApp, ctx: &egui::Context) {
+        let requests = QUEUE.with(|queue| queue.try_borrow_mut().map(|mut q| std::mem::take(&mut *q)).unwrap_or_default());
+        for request in requests {
+            let mut bytes = Vec::new();
+            let result = self.handle(app, ctx, &request, &mut bytes);
+            match result {
+                Ok(result) => emit(
+                    "response",
+                    request.id,
+                    json!({"ok":true,"result":result,"revision":app.session.rev(),"documentId":app.session.document_id()}),
+                    &bytes,
+                ),
+                Err(error) => emit("response", request.id, json!({"ok":false,"error":error}), &[]),
+            }
+        }
+    }
+
+    fn handle(&mut self, app: &mut WordApp, ctx: &egui::Context, request: &Request, bytes: &mut Vec<u8>) -> Result<Value, String> {
+        let args = &request.args;
+        if self.holding && request.method != "saved" {
+            return Err("A save is in progress; retry the command after it finishes".into());
+        }
+        match request.method.as_str() {
+            "open" => {
+                let name = args.get("name").and_then(Value::as_str).ok_or("Missing file name")?;
+                let password = args.get("password").and_then(Value::as_str);
+                let (doc, _) = wordcraft_engine::io::open_bytes_with(name, &request.bytes, password)?;
+                app.session.set_document(doc);
+                app.session.path = Some(std::path::PathBuf::from(name));
+                app.session.password = password.map(wordcraft_engine::Password::new);
+                app.ui.backstage = false;
+                app.dialog = None;
+                app.autosave = false;
+                app.session.dirty = args.get("dirty").and_then(Value::as_bool).unwrap_or(false);
+                app.canvas = Default::default();
+                app.session.run("view.pageWidth", &json!({})).map_err(|error| error.to_string())?;
+                app.ui.show_discord = false;
+                self.loaded = true;
+                self.revision = Some(app.session.rev());
+                ctx.request_repaint();
+                Ok(json!({"opened":true}))
+            }
+            "inbox" => {
+                let name = args.get("name").and_then(Value::as_str).ok_or("Missing file name")?;
+                let inbox = app.services.inbox.as_ref().ok_or("File inbox is unavailable")?;
+                inbox.lock().map_err(|_| "File inbox is busy")?.push((name.into(), request.bytes.clone()));
+                ctx.request_repaint();
+                Ok(json!({"queued":true}))
+            }
+            "export" => {
+                if !self.loaded {
+                    return Err("Document is not loaded".into());
+                }
+                let name = args.get("name").and_then(Value::as_str).unwrap_or("document.docx");
+                if args.get("stamp").and_then(Value::as_bool) == Some(true) {
+                    app.session.stamp_save();
+                }
+                let password = if wordcraft_engine::io::can_encrypt(name) {
+                    app.session.password.as_ref().map(wordcraft_engine::Password::as_str)
+                } else {
+                    None
+                };
+                if name.to_ascii_lowercase().ends_with(".png") {
+                    let page = args.get("page").and_then(Value::as_u64).unwrap_or(1).max(1).saturating_sub(1);
+                    let scale = args.get("scale").and_then(Value::as_f64).unwrap_or(2.0).clamp(0.1, 8.0) as f32;
+                    let layout = app.session.export_layout_with(Default::default());
+                    let page = usize::try_from(page).ok().and_then(|page| layout.pages.get(page)).ok_or("Page is outside the document")?;
+                    let width = page.w * scale;
+                    let height = page.h * scale;
+                    let pixels = (width.ceil() as u64).saturating_mul(height.ceil() as u64);
+                    if !width.is_finite() || !height.is_finite() || pixels > 32_000_000 {
+                        return Err("Image exceeds 32 million pixels; lower the export scale".into());
+                    }
+                    *bytes = wordcraft_engine::render::render_page(&app.session.doc, page, scale, &Default::default()).to_png();
+                } else {
+                    *bytes = wordcraft_engine::io::save_bytes_with(name, &app.session.doc, password, &Default::default())?;
+                }
+                self.holding = args.get("stamp").and_then(Value::as_bool) == Some(true);
+                Ok(json!({"bytes":bytes.len()}))
+            }
+            "saved" => {
+                self.holding = false;
+                if args.get("success").and_then(Value::as_bool) == Some(true)
+                    && args.get("revision").and_then(Value::as_u64) == Some(app.session.rev())
+                {
+                    app.session.dirty = false;
+                    if matches!(app.dialog, Some(wordcraft_ui_egui::dialogs::Dialog::SaveChanges { .. })) {
+                        app.run("ui.saveChanges", json!({"answer":"dontSave"}))?;
+                    }
+                }
+                ctx.request_repaint();
+                Ok(json!({"dirty":app.session.dirty}))
+            }
+            "control" => {
+                let method = args.get("method").and_then(Value::as_str).ok_or("Missing control method")?;
+                let params = args.get("params").cloned().unwrap_or(json!({}));
+                let (req, _) = wordcraft_ui_egui::control::ControlRequest::new(method, params);
+                let result = match wordcraft_ui_egui::control::handle(app, ctx, &req) {
+                    wordcraft_ui_egui::control::Outcome::Done(value) => value,
+                    wordcraft_ui_egui::control::Outcome::Screenshot { .. } => {
+                        return Err("Capture the AI Office window using the host screenshot tools".into());
+                    }
+                };
+                ctx.request_repaint();
+                Ok(result)
+            }
+            _ => Err("Unknown host request".into()),
+        }
+    }
+
+    pub fn snapshot(&mut self, app: &WordApp) {
+        if !self.loaded || self.revision == Some(app.session.rev()) {
+            return;
+        }
+        match wordcraft_engine::io::save_bytes_with(
+            "document.docx",
+            &app.session.doc,
+            app.session.password.as_ref().map(wordcraft_engine::Password::as_str),
+            &Default::default(),
+        ) {
+            Ok(bytes) => {
+                self.revision = Some(app.session.rev());
+                emit(
+                    "edit",
+                    0,
+                    json!({"revision":app.session.rev(),"documentId":app.session.document_id(),"dirty":app.session.dirty,"undo":app.session.can_undo(),"redo":app.session.can_redo()}),
+                    &bytes,
+                );
+            }
+            Err(error) => emit("error", 0, json!({"error":error}), &[]),
+        }
+    }
+}
