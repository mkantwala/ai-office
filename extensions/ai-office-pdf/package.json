			{
				"name": "office_document_edit",
				"toolReferenceName": "officeDocumentEdit",
				"displayName": "Edit Word Content",
				"userDescription": "Edit Word Content in the live Word editor.",
				"modelDescription": "Edit native Word blocks atomically. replaceText uses literal find + optional nth and preserves surrounding formatting/objects. update uses Unicode ranges. Include ifHash from read for safe text edits across unrelated revisions. Structural insert/delete/replaceBlocks require a fresh version; replaceBlocks intentionally retires old IDs and structure. Comment anchor detachment is refused unless explicitly authorized with allowDetach. Successful receipts are undoable and unsaved; leave Keep/Undo decisions to the user. For formatting use office_document_format. replaceText REQUIRES id, version, find (OLD words), and text (NEW words). Example: {operation:\"replaceText\",id:<from read>,version:<from read>,find:\"Maya\",text:\"Priya\"}. edits is only valid when operation=batch.",
				"canBeReferencedInPrompt": true,
				"inputSchema": {
					"type": "object",
					"properties": {
						"uri": {
							"type": "string",
							"description": "URI of an open Word document. Omit for the active or sole open Word document."
						},
						"operation": {
							"type": "string",
							"enum": [
								"insert",
								"update",
								"delete",
								"command",
								"batch",
								"replaceText",
								"replaceBlocks"
							]
						},
						"id": {
							"type": "string",
							"description": "Internal block ID returned by read. Never invent it or show it to the user."
						},
						"version": {
							"type": "string",
							"description": "Exact version returned by the latest read. Required for edits and activity start."
						},
						"position": {
							"type": "string",
							"enum": [
								"before",
								"after"
							]
						},
						"blocks": {
							"type": "array",
							"minItems": 1,
							"maxItems": 50,
							"items": {
								"type": "object",
								"properties": {
									"kind": {
										"type": "string",
										"enum": [
											"paragraph",
											"heading",
											"table"
										]
									},
									"text": {
										"type": "string",
										"maxLength": 100000
									},
									"style": {
										"type": "string"
									},
									"rows": {
										"type": "array",
										"maxItems": 20,
										"items": {
											"type": "array",
											"maxItems": 10,
											"items": {
												"type": "string",
												"maxLength": 10000
											}
										}
									}
								},
								"required": [
									"kind"
								],
								"additionalProperties": false
							}
						},
						"text": {
							"type": "string",
							"maxLength": 100000,
							"description": "Required for update and replaceText: NEW replacement text. For replaceText also send id, version and find=old text."
						},
						"start": {
							"type": "integer",
							"minimum": 0,
							"description": "Unicode code point offset within paragraph, inclusive."
						},
						"end": {
							"type": "integer",
							"minimum": 0,
							"description": "Unicode code point offset within paragraph, exclusive."
						},
						"command": {
							"type": "string"
						},
						"params": {
							"type": "object"
						},
						"edits": {
							"type": "array",
							"minItems": 1,
							"maxItems": 200,
							"items": {
								"type": "object",
								"properties": {
									"operation": {
										"type": "string",
										"enum": [
											"insert",
											"update",
											"delete",
											"command",
											"replaceText",
											"replaceBlocks"
										]
									},
									"id": {
										"type": "string",
										"description": "Internal block ID returned by read. Never invent it or show it to the user."
									},
									"position": {
										"type": "string",
										"enum": [
											"before",
											"after"
										]
									},
									"blocks": {
										"type": "array",
										"minItems": 1,
										"maxItems": 50,
										"items": {
											"type": "object",
											"properties": {
												"kind": {
													"type": "string",
													"enum": [
														"paragraph",
														"heading",
														"table"
													]
												},
												"text": {
													"type": "string",
													"maxLength": 100000
												},
												"style": {
													"type": "string"
												},
												"rows": {
													"type": "array",
													"maxItems": 20,
													"items": {
														"type": "array",
														"maxItems": 10,
														"items": {
															"type": "string",
															"maxLength": 10000
														}
													}
												}
											},
											"required": [
												"kind"
											],
											"additionalProperties": false
										}
									},
									"text": {
										"type": "string",
										"maxLength": 100000,
										"description": "Required for update and replaceText: NEW replacement text. For replaceText also send id, version and find=old text."
									},
									"start": {
										"type": "integer",
										"minimum": 0,
										"description": "Unicode code point offset within paragraph, inclusive."
									},
									"end": {
										"type": "integer",
										"minimum": 0,
										"description": "Unicode code point offset within paragraph, exclusive."
									},
									"command": {
										"type": "string"
									},
									"params": {
										"type": "object"
									},
									"ifHash": {
										"type": "string",
										"pattern": "^[a-fA-F0-9]{64}$",
										"description": "Block hash from read. Allows only text edits to unchanged blocks across unrelated revisions."
									},
									"allowDetach": {
										"type": "boolean",
										"description": "Only when explicitly authorized to detach comment anchors or remove inline objects."
									},
									"find": {
										"type": "string",
										"minLength": 1,
										"maxLength": 2000
									},
									"nth": {
										"type": "integer",
										"minimum": 1,
										"description": "1-based literal occurrence; required if ambiguous."
									}
								},
								"required": [
									"id",
									"operation"
								],
								"additionalProperties": false,
								"allOf": [
									{
										"if": {
											"properties": {
												"operation": {
													"enum": [
														"update",
														"replaceText"
													]
												}
											}
										},
										"then": {
											"required": [
												"text"
											]
										}
									},
									{
										"if": {
											"properties": {
